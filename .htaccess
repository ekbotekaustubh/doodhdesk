<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /milkman/

    # Direct access to real files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else through index.php
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
